<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>pt.paradigmshift.iot</groupId>
	<artifactId>babel-raspberry-iot-examples</artifactId>
	<version>0.1.1</version>
	<name>ParadigmShift Babel IoT Examples for Raspberry Pi</name>

	<description>
		Runnable demo applications showing how to control IoT devices and radios
		with Babel using the ParadigmShift libraries: the IoT control protocols
		(Grove LED matrix / LCD / chainable RGB LED / gesture / encoder) plus the
		LoRa and ZigBee radio protocols over the shared babel-radio-api surface.
		This is a collection of executables for learning and bring-up, NOT a
		library — it is intentionally not published to the ParadigmShift Maven
		repository and must NOT appear in the libraries section of the
		ParadigmShift website. There is no `distributionManagement` block in
		this POM on purpose; do not add one, and do not add an `mvn deploy`
		step to .github/workflows/ci.yml.
	</description>
	<url>https://www.paradigmshift.pt</url>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.source>17</maven.compiler.source>
		<maven.compiler.target>17</maven.compiler.target>
	</properties>

	<!-- All dependencies resolve from the ParadigmShift Maven repository
	     (read-open; no credentials needed). -->
	<repositories>
		<repository>
			<id>paradigmshift-repository</id>
			<name>ParadigmShift Repository</name>
			<url>https://maven.paradigmshift.pt/releases</url>
		</repository>
	</repositories>

	<dependencies>
		<!-- IoT device control (NOVA FCT / TaRDIS-derived, maintained by
		     ParadigmShift). Transitively brings babel-core, babel-iot-control-api,
		     pi4j-iot-device-library, pi4j-components and pi4j-shared-context. -->
		<dependency>
			<groupId>pt.paradigmshift.iot</groupId>
			<artifactId>babel-iot-control-protocols</artifactId>
			<version>1.3.0</version>
		</dependency>

		<!-- Radio stack: shared API surface + the LoRa and ZigBee protocol
		     wrappers (each brings its standalone driver transitively). -->
		<dependency>
			<groupId>pt.paradigmshift.babel</groupId>
			<artifactId>babel-radio-api</artifactId>
			<version>0.3.0</version>
		</dependency>
		<dependency>
			<groupId>pt.paradigmshift.babel</groupId>
			<artifactId>babel-lora-protocol</artifactId>
			<version>0.4.0</version>
		</dependency>
		<dependency>
			<groupId>pt.paradigmshift.babel</groupId>
			<artifactId>babel-zigbee-protocol</artifactId>
			<version>0.5.0</version>
		</dependency>

		<!-- The radio demos build the one shared Pi4J context for the LoRa HAT. -->
		<dependency>
			<groupId>pt.paradigmshift.iot</groupId>
			<artifactId>pi4j-shared-context</artifactId>
			<version>0.1.0</version>
		</dependency>
	</dependencies>

	<build>
		<sourceDirectory>src/main/java</sourceDirectory>
		<!-- The runnable artifact is the shaded fat JAR produced below
		     (target/babel-raspberry-iot-examples.jar), not a Maven-deployed library. -->
		<finalName>babel-raspberry-iot-examples</finalName>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.12.1</version>
			</plugin>

			<!-- Javadoc generation. Pinned + doclint disabled so a stray/missing
			     tag can't fail the build. Run by CI (`mvn javadoc:javadoc`, output
			     in target/site/apidocs) and published to GitHub Pages — see
			     .github/workflows/ci.yml. No attach execution: these demos are not
			     a Maven artifact, so we don't bundle a -javadoc.jar at package time. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-javadoc-plugin</artifactId>
				<version>3.6.3</version>
				<configuration>
					<doclint>none</doclint>
					<quiet>true</quiet>
					<windowtitle>ParadigmShift Babel IoT Examples API</windowtitle>
					<doctitle>ParadigmShift Babel IoT Examples ${project.version} API</doctitle>
					<bottom>Copyright &amp;copy; 2026 ParadigmShift, Lda. See LICENSE for terms.</bottom>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<version>3.5.3</version>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<minimizeJar>false</minimizeJar>
							<createDependencyReducedPom>true</createDependencyReducedPom>
							<dependencyReducedPomLocation>
								${java.io.tmpdir}/dependency-reduced-pom.xml
							</dependencyReducedPomLocation>
							<transformers>
								<transformer
									implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
									<mainClass>Main</mainClass>
								</transformer>
							</transformers>
							<filters>
								<filter>
									<artifact>*:*</artifact>
									<excludes>
										<exclude>META-INF/*.SF</exclude>
										<exclude>META-INF/*.DSA</exclude>
										<exclude>META-INF/*.RSA</exclude>
									</excludes>
								</filter>
							</filters>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
